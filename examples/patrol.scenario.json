    {
      "op": "assert",
      "condition": {
        "kind": "npc_memory",
        "id": "hunter",
        "source": null
      }
    },
    {
      "op": "until",
      "condition": {
        "kind": "patrol_visits",
        "id": "hunter",
        "at_least": 1
      },
      "max_ticks": 1000
    }
